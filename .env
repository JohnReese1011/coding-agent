# ============================================================
# Chat model: choose one provider; restart LangGraph Server after changes.
# Supported: ollama | openai | openai_compatible | anthropic
# ============================================================
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
OLLAMA_NUM_CTX=16384

# Legacy Ollama variables remain supported for existing .env files.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0.1

# ============================================================
# Embedding model: independent from chat model.
# Supported: ollama | openai | openai_compatible
# ============================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
# Legacy variable remains supported.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# OpenAI example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...

# DeepSeek OpenAI-compatible chat example:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your-deepseek-api-key

# Qwen/DashScope OpenAI-compatible chat example:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=your-dashscope-api-key

# SiliconFlow-compatible chat + embeddings example:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=your-siliconflow-api-key
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=your-siliconflow-api-key

WORKSPACE=./workspace
MCP_CONFIG=./config/mcp_servers.json
MILVUS_URI=./data/milvus.db
# Leave unset to auto-create a provider/model-specific collection name.
# Set explicitly only when you know the embedding dimensions are compatible.
# MILVUS_COLLECTION=code_chunks_custom
API_HOST=127.0.0.1
API_PORT=8000
